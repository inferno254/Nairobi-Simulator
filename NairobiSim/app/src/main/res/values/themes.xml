<resources>
    <style name="Theme.NairobiSim" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nairobi_primary</item>
        <item name="colorPrimaryVariant">@color/nairobi_primary_dark</item>
        <item name="colorOnPrimary">@color/nairobi_on_primary</item>
        <item name="colorSecondary">@color/nairobi_secondary</item>
        <item name="colorSecondaryVariant">@color/nairobi_secondary_dark</item>
        <item name="colorOnSecondary">@color/nairobi_on_secondary</item>
        <item name="colorTertiary">@color/nairobi_tertiary</item>
        <item name="colorOnTertiary">@color/nairobi_on_tertiary</item>
        <item name="colorSurface">@color/nairobi_surface</item>
        <item name="colorOnSurface">@color/nairobi_text_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorError">@color/nairobi_error</item>
        <item name="colorOnError">@color/nairobi_on_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/color_on_tertiary_container</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="android:windowBackground">@color/nairobi_bg</item>
        <item name="android:statusBarColor">@color/nairobi_primary_dark</item>
        <item name="android:navigationBarColor">@color/nairobi_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.NairobiSim.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.NairobiSim.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.NairobiSim.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="Widget.NairobiSim.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.NairobiSim.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.NairobiSim.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nairobi_secondary</item>
    </style>

    <style name="ShapeAppearanceOverlay.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.CornerSize8" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.CornerSize12" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.CornerSize16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.NairobiSim.ProgressBar.Horizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">@color/nairobi_primary</item>
        <item name="android:progressBackgroundTint">@color/nairobi_divider</item>
    </style>

    <style name="Widget.NairobiSim.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/nairobi_primary</item>
        <item name="rippleColor">@color/nairobi_primary_light</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
    </style>

    <style name="Widget.NairobiSim.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/nairobi_primary</item>
        <item name="rippleColor">@color/nairobi_primary_light</item>
    </style>

    <style name="Widget.NairobiSim.Card" parent="">
        <item name="cardBackgroundColor">@color/nairobi_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.NairobiSim.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/nairobi_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
    </style>

</resources>
