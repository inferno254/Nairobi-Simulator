<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="event"
            type="com.nairobisim.model.MarketEvent" />
        <variable
            name="viewModel"
            type="com.nairobisim.ui.main.MainViewModel" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="@{event.isActive ? 4f : 1f}"
        app:strokeColor="@{event.isActive ? @color/nairobi_orange : @color/transparent}"
        app:strokeWidth="@{event.isActive ? 2f : 0f}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@{event.isActive ? @color/nairobi_orange_light : @color/nairobi_grey_light}">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_event"
                    android:tint="@{event.isActive ? @color/nairobi_orange : @color/nairobi_grey}" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@{event.name}"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Fuel Price Surge" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{event.type.name}"
                        android:textSize="10sp"
                        app:chipBackgroundColor="@{event.isActive ? @color/nairobi_orange : @color/nairobi_grey}"
                        android:textColor="@color/nairobi_white"
                        tools:text="Cost Spike" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{event.description}"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_grey"
                    tools:text="Fuel prices up 15%. Transport costs increase." />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{\"Duration: \" + event.durationDays + \" days\"}"
                            android:textSize="11sp"
                            android:textColor="@color/nairobi_grey"
                            tools:text="Duration: 30 days" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@{\"Severity: \" + (event.severity * 100).toInt() + \"%\"}"
                            android:textSize="11sp"
                            android:textColor="@{event.severity > 0.5 ? @color/expense_red : @color/nairobi_orange}"
                            tools:text="Severity: 75%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@{event.isActive ? \"ACTIVE\" : \"ENDED\"}"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@{event.isActive ? @color/nairobi_orange : @color/nairobi_green}"
                            tools:text="ACTIVE" />

                    </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.formatImpact(event.impact)}"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@{event.impact >= 0 ? @color/income_green : @color/expense_red}"
                    tools:text="-KES 50,000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Impact"
                    android:textSize="11sp"
                    android:textColor="@color/nairobi_grey" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>