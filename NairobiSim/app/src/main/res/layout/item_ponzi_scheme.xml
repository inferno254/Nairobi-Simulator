<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/nairobi_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSchemeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scheme Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary" />

            <TextView
                android:id="@+id/txtSchemeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_warning" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txtSchemeType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Investment Club"
                android:textSize="12sp"
                android:textColor="@color/nairobi_text_secondary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtPromoter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promoter"
                android:textSize="12sp"
                android:textColor="@color/nairobi_text_secondary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="12sp"
                android:textColor="@color/nairobi_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPromisedReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Promised: 100% per month"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/nairobi_error"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtMinInvestment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Min: KES 10,000"
            android:textSize="12sp"
            android:textColor="@color/nairobi_text_secondary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtSchemeWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WARNING: This looks like a ponzi scheme!"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/nairobi_error"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/edtInvestAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Amount (KES)"
                android:inputType="number"
                android:textSize="14sp"
                android:background="@drawable/bg_stat_card"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnInvest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVEST"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/nairobi_error"
                android:textColor="@android:color/white"
                android:layout_marginStart="8dp"
                style="@style/Widget.NairobiSim.Button.Primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>