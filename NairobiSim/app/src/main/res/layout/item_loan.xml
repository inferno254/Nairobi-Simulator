<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="loan"
            type="com.nairobisim.model.Loan" />
        <variable
            name="viewModel"
            type="com.nairobisim.ui.main.MainViewModel" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/nairobi_blue">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_loan"
                            android:tint="@color/nairobi_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{loan.lenderName}"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Equity Bank" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@{loan.type.name}"
                            android:textSize="12sp"
                            android:textColor="@color/nairobi_grey"
                            tools:text="Business Loan" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.formatKes(loan.remainingBalance)}"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/expense_red"
                            tools:text="KES 850,000" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Outstanding"
                            android:textSize="11sp"
                            android:textColor="@color/nairobi_grey" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@{\"Monthly: \" + viewModel.formatKes(loan.monthlyPayment)}"
                        android:textSize="13sp"
                        android:textColor="@color/expense_red"
                        tools:text="Monthly: KES 25,000" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@{\"Interest: \" + (loan.interestRate * 100).toInt() + \"%\"}"
                        android:textSize="13sp"
                        android:textColor="@color/nairobi_orange"
                        android:gravity="center"
                        tools:text="Interest: 14%" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@{\"Months left: \" + loan.monthsRemaining}"
                        android:textSize="13sp"
                        android:textColor="@color/nairobi_grey"
                        android:gravity="end"
                        tools:text="Months left: 34" />

                </LinearLayout>

                <android.widget.ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.ProgressBar.Horizontal"
                    android:progress="@{(100 * (loan.originalAmount - loan.remainingBalance) / loan.originalAmount).toInt()}"
                    android:progressTint="@color/nairobi_green"
                    android:progressBackgroundTint="@color/nairobi_grey_light"
                    tools:progress="30" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{\"Repaid: \" + viewModel.formatKes(loan.originalAmount - loan.remainingBalance) + \" of \" + viewModel.formatKes(loan.originalAmount)}"
                    android:textSize="11sp"
                    android:textColor="@color/nairobi_grey"
                    android:gravity="center"
                    tools:text="Repaid: KES 250,000 of KES 1,000,000" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>