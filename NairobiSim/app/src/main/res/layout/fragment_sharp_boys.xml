<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.nairobisim.ui.sharpboys.SharpBoysViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/nairobi_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/nairobi_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STREETS OF NAIROBI"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nairobi_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sharp Boys Encounters"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/nairobi_text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Every day in Nairobi, you face the sharp boys, kanjos, and corrupt officials. Your choices determine whether you keep your money, your phone, or your life."
                        android:textSize="14sp"
                        android:textColor="@color/nairobi_text_secondary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_stat_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Street Cred"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:id="@+id/txtStreetCred"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_stat_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reputation"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:id="@+id/txtReputation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_secondary" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Current Encounter Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/encounterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/encounterCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/nairobi_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="12dp"
                    app:strokeColor="@color/nairobi_secondary"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/encounterType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_text_primary"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/encounterLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/nairobi_text_secondary"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/encounterDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/nairobi_text_primary"
                            android:layout_marginBottom="20dp" />

                        <TextView
                            android:id="@+id/encounterDemand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_error"
                            android:layout_marginBottom="16dp" />

                        <!-- Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <Button
                                android:id="@+id/btnPay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pay Them"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/nairobi_primary"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="8dp"
                                style="@style/Widget.NairobiSim.Button.Primary" />

                            <Button
                                android:id="@+id/btnRefuse"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Refuse &amp; Walk Away"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/nairobi_error"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="8dp"
                                style="@style/Widget.NairobiSim.Button.Primary" />

                            <Button
                                android:id="@+id/btnNegotiate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Negotiate"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/nairobi_warning"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="8dp"
                                style="@style/Widget.NairobiSim.Button.Primary" />

                            <Button
                                android:id="@+id/btnFight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fight Back"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/nairobi_tertiary"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="8dp"
                                style="@style/Widget.NairobiSim.Button.Primary" />

                            <Button
                                android:id="@+id/btnEscape"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Try to Escape"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/nairobi_teal"
                                android:textColor="@android:color/white"
                                android:layout_marginBottom="8dp"
                                style="@style/Widget.NairobiSim.Button.Primary" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Generate New Encounter Button -->
                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encounter the Streets"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/nairobi_secondary"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.NairobiSim.Button.Primary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Encounter Result -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/nairobi_surface_light"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/resultType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/resultMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/nairobi_text_primary"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_result_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Impact"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_text_secondary"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/resultImpact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/nairobi_text_primary" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnDismiss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Continue"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/nairobi_primary"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp"
                            style="@style/Widget.NairobiSim.Button.Primary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Encounter History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encounter History"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemcount="5"
                    tools:listitem="@layout/item_encounter_history" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
