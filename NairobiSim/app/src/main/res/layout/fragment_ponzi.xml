<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nairobi_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nairobi_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PONZI SCHEMES / INVESTMENTS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_error"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Get Rich Quick Schemes"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invest in schemes promising high returns. But remember - if it sounds too good to be true, it probably is. Schemes collapse and disappear with your money."
                    android:textSize="14sp"
                    android:textColor="@color/nairobi_text_secondary"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Invested"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_text_secondary" />

                        <TextView
                            android:id="@+id/txtTotalInvested"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_error" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lost Money"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_text_secondary" />

                        <TextView
                            android:id="@+id/txtLostMoney"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_tertiary" />
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refresh Schemes"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/nairobi_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.NairobiSim.Button.Primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Schemes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Investment Schemes"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSchemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemcount="5"
                tools:listitem="@layout/item_ponzi_scheme" />
        </LinearLayout>

        <!-- My Investments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Investments"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInvestments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemcount="5"
                tools:listitem="@layout/item_ponzi_investment" />
        </LinearLayout>

        <!-- Result -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/nairobi_surface_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/resultMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Result"
                        android:textSize="15sp"
                        android:textColor="@color/nairobi_text_primary"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnDismissResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Continue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/nairobi_primary"
                        android:textColor="@android:color/white"
                        style="@style/Widget.NairobiSim.Button.Primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>