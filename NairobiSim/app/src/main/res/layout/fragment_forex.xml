<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.nairobisim.ui.forex.ForexViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/nairobi_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/nairobi_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FOREX MARKET"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nairobi_primary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available Balance"
                                android:textSize="14sp"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(&quot;KES %.2f&quot;, viewModel.balance)}"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Equity"
                                android:textSize="14sp"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(&quot;KES %.2f&quot;, viewModel.equity)}"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_success" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/nairobi_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Used Margin"
                                android:textSize="12sp"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(&quot;KES %.2f&quot;, viewModel.usedMargin)}"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Free Margin"
                                android:textSize="12sp"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(&quot;KES %.2f&quot;, viewModel.freeMargin)}"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/nairobi_text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Margin Level"
                                android:textSize="12sp"
                                android:textColor="@color/nairobi_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{String.format(&quot;%.1f%%&quot;, viewModel.marginLevel)}"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@{viewModel.marginLevel > 100 ? @color/nairobi_success : @color/nairobi_error}" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Currency Pairs -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MARKET RATES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_primary"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pairsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Trade Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/nairobi_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLACE TRADE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nairobi_primary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="16dp" />

                    <!-- Pair Selection -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="@color/nairobi_input_bg">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/pairSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.selectedPair != null ? viewModel.selectedPair.displayName : &quot;&quot;}"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:clickable="true"
                            android:textSize="16sp"
                            android:padding="14dp"
                            android:textColor="@color/nairobi_text_primary"
                            android:hint="Select Currency Pair" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Trade Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBuy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="BUY (Long)"
            app:icon="@drawable/ic_arrow_up"
            android:textColor="@color/nairobi_success"
            app:iconTint="@color/nairobi_success"
            android:backgroundTint="@color/nairobi_success_light"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="SELL (Short)"
            app:icon="@drawable/ic_arrow_down"
            android:textColor="@color/nairobi_error"
            app:iconTint="@color/nairobi_error"
            android:backgroundTint="@color/nairobi_error_light"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>

                    <!-- Lot Size -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="@color/nairobi_input_bg">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLotSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Lot Size (0.01 - 100)"
            android:inputType="numberDecimal"
            android:textSize="16sp"
            android:padding="14dp"
            android:textColor="@color/nairobi_text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Stop Loss / Take Profit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:hintEnabled="false"
                            app:boxBackgroundColor="@color/nairobi_input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStopLoss"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Stop Loss (price)"
            android:inputType="numberDecimal"
            android:textSize="14sp"
                                android:padding="12dp"
                                android:textColor="@color/nairobi_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            app:hintEnabled="false"
                            app:boxBackgroundColor="@color/nairobi_input_bg">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTakeProfit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Take Profit (price)"
            android:inputType="numberDecimal"
            android:textSize="14sp"
                                android:padding="12dp"
                                android:textColor="@color/nairobi_text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecuteTrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EXECUTE TRADE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:padding="16dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Open Positions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OPEN POSITIONS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_primary"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{&quot;(&quot; + viewModel.openTrades.size + &quot;)&quot;}"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_text_secondary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/openPositionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Trade History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRADE HISTORY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_primary"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{&quot;(&quot; + viewModel.tradeHistory.size + &quot;)&quot;}"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_text_secondary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tradeHistoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
