<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nairobi_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with real bookmaker info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nairobi_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL ODDS BETTING"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_secondary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SportPesa • Betway • 1xBet"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Real odds from Kenyan bookmakers. Place bets, win money."
                    android:textSize="14sp"
                    android:textColor="@color/nairobi_text_secondary"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Betting Wallet"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_text_secondary" />

                        <TextView
                            android:id="@+id/txtWallet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Won"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_text_secondary" />

                        <TextView
                            android:id="@+id/txtTotalWon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KES 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/nairobi_secondary" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnAddMoney"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Add KES 50K"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/nairobi_primary"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.NairobiSim.Button.Primary" />

                    <Button
                        android:id="@+id/btnSimulate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Simulate Results"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/nairobi_secondary"
                        android:textColor="@android:color/white"
                        style="@style/Widget.NairobiSim.Button.Primary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Available Matches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Matches (Real Odds)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemcount="5"
                tools:listitem="@layout/item_betting_match" />
        </LinearLayout>

        <!-- My Bets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Bets"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemcount="5"
                tools:listitem="@layout/item_bet_slip" />
        </LinearLayout>

        <!-- Result -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/nairobi_surface_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/resultMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Result"
                        android:textSize="15sp"
                        android:textColor="@color/nairobi_text_primary"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnDismissResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Continue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/nairobi_primary"
                        android:textColor="@android:color/white"
                        style="@style/Widget.NairobiSim.Button.Primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>