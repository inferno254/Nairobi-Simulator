<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/nairobi_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtInvScheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scheme"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_text_primary" />

            <TextView
                android:id="@+id/txtInvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txtInvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invested: KES 10,000"
                android:textSize="12sp"
                android:textColor="@color/nairobi_text_secondary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtInvExpected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expected: KES 20,000"
                android:textSize="12sp"
                android:textColor="@color/nairobi_text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCollect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collect Returns"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/nairobi_primary"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            style="@style/Widget.NairobiSim.Button.Primary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>