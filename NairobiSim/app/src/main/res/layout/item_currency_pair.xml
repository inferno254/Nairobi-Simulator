<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="pair"
            type="com.nairobisim.model.CurrencyPair" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/nairobi_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pairSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KES/USD"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary" />

                <TextView
                    android:id="@+id/pairName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kenyan Shilling / US Dollar"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/pairSpread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spread: 2 pips"
                android:textSize="12sp"
                android:textColor="@color/nairobi_accent"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
