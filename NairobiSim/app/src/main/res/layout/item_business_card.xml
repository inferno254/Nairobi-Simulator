<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="business"
            type="com.nairobisim.model.Business" />
        <variable
            name="viewModel"
            type="com.nairobisim.ui.main.MainViewModel" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:onClick="@{() -> viewModel.selectBusiness(business)}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_business_placeholder"
                android:background="@color/nairobi_green_light"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CornerSize8" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{business.name}"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Matatu Sacco (CBD)" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{business.category.displayName + \" • \" + business.location.displayName}"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_grey"
                    tools:text="Transport • CBD" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@{\"Level \" + business.level}"
                            android:textSize="11sp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:background="@drawable/bg_level_badge"
                            android:textColor="@color/nairobi_white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@{business.isOperational ? \"Operational\" : \"Closed\"}"
                            android:textSize="11sp"
                            android:textColor="@{business.isOperational ? @color/income_green : @color/expense_red}" />

                    </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.formatKes(business.netMonthlyIncome)}"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@{business.netMonthlyIncome >= 0 ? @color/income_green : @color/expense_red}"
                    tools:text="KES 120,000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{\"Revenue: \" + viewModel.formatKes(business.monthlyRevenue)}"
                    android:textSize="11sp"
                    android:textColor="@color/nairobi_grey" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>