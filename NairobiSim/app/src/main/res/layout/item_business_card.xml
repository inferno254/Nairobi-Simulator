<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="business"
            type="com.nairobisim.model.Business" />
        <variable
            name="viewModel"
            type="com.nairobisim.ui.main.MainViewModel" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/nairobi_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/nairobi_divider"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> viewModel.selectBusiness(business)}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:src="@{viewModel.categoryIcon(business.category)}"
                android:backgroundTint="@{viewModel.categoryColor(business.category)}"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CornerSize12"
                tools:src="@drawable/ic_car"
                tools:backgroundTint="@color/cat_matatu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{business.name}"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Matatu Sacco (CBD)" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@{business.category.displayName + &quot; • &quot; + business.location.displayName}"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_text_secondary"
                    tools:text="Transport • CBD" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{&quot;Level &quot; + business.level + (business.isOperational ? &quot;  •  Operational&quot; : &quot;  •  Closed&quot;)}"
                    android:textSize="11sp"
                    android:textColor="@{business.isOperational ? @color/income_green : @color/expense_red}"
                    tools:text="Level 1 • Operational" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.formatHourly(business.hourlyProfit)}"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@{business.netMonthlyIncome >= 0 ? @color/income_green : @color/expense_red}"
                    tools:text="KES 167 /hr" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@{viewModel.formatKes(business.netMonthlyIncome) + &quot; /mo&quot;}"
                    android:textSize="11sp"
                    android:textColor="@color/nairobi_text_secondary"
                    tools:text="KES 120,000 /mo" />

            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/nairobi_text_disabled" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>