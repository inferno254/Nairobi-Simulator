<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="company"
            type="com.nairobisim.model.ShareCompany" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/nairobi_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/companyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SawaCom"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary" />

                <TextView
                    android:id="@+id/companySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SWC"
                    android:textSize="14sp"
                    android:textColor="@color/nairobi_text_secondary" />

                <TextView
                    android:id="@+id/companySector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telecom"
                    android:textSize="12sp"
                    android:textColor="@color/nairobi_accent"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/companyPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KES 18.50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_text_primary" />

                <TextView
                    android:id="@+id/companyChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2.50%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/nairobi_success" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
