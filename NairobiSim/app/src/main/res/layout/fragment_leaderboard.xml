<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.nairobisim.ui.leaderboard.LeaderboardViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Forbes Nairobi Rich List"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/nairobi_primary" />

            <!-- Tab buttons -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tab_overall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overall"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/nairobi_text_primary"
                        android:padding="12dp" />

                    <Button
                        android:id="@+id/tab_weekly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weekly"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/nairobi_text_primary"
                        android:padding="12dp" />

                    <Button
                        android:id="@+id/tab_your_rank"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Rank"
                        android:background="@drawable/bg_tab_unselected"
                        android:textColor="@color/nairobi_text_primary"
                        android:padding="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Leaderboard Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/leaderboard_recycler"
                android:layout_width="match_parent"
                android:layout_height="500dp" />

            <!-- Your Rank Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wealth_breakdown_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/nairobi_accent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your Wealth Breakdown"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/your_rank_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Your Rank: #1"
                        android:textSize="16sp"
                        android:textColor="@android:color/white" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#88FFFFFF" />

                    <TextView
                        android:id="@+id/wealth_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Net Worth: KES 1,000,000"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_cash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cash and Bank: KES 500,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_businesses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Businesses: KES 2,000,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_vehicles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vehicles: KES 300,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_stocks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stocks: KES 150,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_forex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Forex: KES 50,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/wealth_other"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Crypto and Other: KES 10,000"
                        android:textSize="13sp"
                        android:textColor="#DDFFFFFF" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>